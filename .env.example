# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=sih_intelligence
POSTGRES_USER=sih
POSTGRES_PASSWORD=change_me_in_production

# Used by the backend directly (asyncpg driver)
DATABASE_URL=postgresql://sih:change_me_in_production@localhost:5432/sih_intelligence

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate-a-strong-secret-key-here-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ── Demo / synthetic mode ─────────────────────────────────────────────────────
DEMO_MODE=true
SYNTHETIC_DEMO_MODE=true

# ── AI APIs (leave empty to use mock / fallback responses) ───────────────────
ANTHROPIC_API_KEY=
SARVAM_API_KEY=

# ── Local LLM ────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ── Seed admin account ────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@sih.gov.in
ADMIN_PASSWORD=Admin@SIH2026
ADMIN_NAME=Platform Administrator

# ── Platform connectors (Component A) ─────────────────────────────────────────
# Each connector runs in mock mode until its credentials are set, so the stack
# works end-to-end with none of these filled in. A live API failure falls back
# to mock rather than stopping the pipeline.

# Essential: X (Twitter) — Live collection via Twikit
X_COOKIES_PATH=
X_USERNAME=
X_EMAIL=
X_PASSWORD=
X_BEARER_TOKEN=
X_SEARCH_QUERY=(india OR bharat) -is:retweet
X_MAX_RESULTS=100

# Essential: Telegram — Bot API (bot must be a member of the channels).
# Full public channel history needs MTProto (TELEGRAM_API_ID/HASH + Telethon).
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_CHANNELS=[]

# Desirable: Instagram / Facebook (Meta Graph API)
META_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=
FACEBOOK_PAGE_ID=

# Appreciable: Reddit / YouTube
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=sih-intelligence/1.0
REDDIT_SUBREDDITS=["india","IndiaSpeaks","unitedstatesofindia"]
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_IDS=[]

# ── Ingestion behaviour ───────────────────────────────────────────────────────
INGEST_TIMEOUT_SECONDS=20
INGEST_RETENTION_DAYS=30
# Rotate this regularly — it is the salt for author pseudonymisation, and
# rotating it breaks linkage of an author across rotation periods.
PSEUDONYM_SALT=rotate-this-salt-daily-in-production

# ── Analysis tuning ───────────────────────────────────────────────────────────
# Sarcasm confidence above which the surface reading is inverted (Component B).
SARCASM_THRESHOLD=0.55
# Trend burst threshold, in standard deviations above a topic's own baseline.
TREND_BURST_SIGMA=2.0
TREND_MIN_VOLUME=5
TREND_WINDOW_HOURS=24
# Network / diffusion (Component E)
NETWORK_MAX_NODES=400
DIFFUSION_MIN_HOP_POSTS=3

# ── Transformer models ────────────────────────────────────────────────────────
# Off by default: the rule-based engine covers every sentiment axis on its own.
# To enable, install requirements-ml.txt, run app.scripts.download_models
# (~2.2 GB), then set this true. Verify with app.scripts.verify_models.
USE_REAL_NLP=false
HF_CACHE_DIR=./.cache/huggingface
NLP_BATCH_SIZE=16

# ── Local LLM (Ollama) ────────────────────────────────────────────────────────
# `ollama pull llama3.2:3b`. Used for persona prose and executive briefs only —
# classification stays with the discriminative models.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ── Dev convenience ───────────────────────────────────────────────────────────
# Run pipeline stages inline instead of queueing on Celery/Redis, so the stack
# works with no broker. See docs/local-dev.md.
DEV_INLINE_TASKS=false
